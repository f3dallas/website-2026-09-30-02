{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "destination": "/index.rsc"
    },
    {
      "source": "/connect",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "destination": "/connect.rsc"
    },
    {
      "source": "/disclaimer",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "destination": "/disclaimer.rsc"
    },
    {
      "source": "/photos",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "destination": "/photos.rsc"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "destination": "/privacy.rsc"
    },
    {
      "source": "/t-claps",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "destination": "/t-claps.rsc"
    },
    {
      "source": "/what-is-f3",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "destination": "/what-is-f3.rsc"
    },
    {
      "source": "/workouts",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "destination": "/workouts.rsc"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)\\.rsc",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-component; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
