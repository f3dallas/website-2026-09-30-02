{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/_next/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)\\.rsc",
      "headers": {
        "Content-Type": "text/x-component; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "dest": "/index.rsc",
      "headers": {
        "Content-Type": "text/x-component; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/connect",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "dest": "/connect.rsc",
      "headers": {
        "Content-Type": "text/x-component; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/disclaimer",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "dest": "/disclaimer.rsc",
      "headers": {
        "Content-Type": "text/x-component; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/photos",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "dest": "/photos.rsc",
      "headers": {
        "Content-Type": "text/x-component; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/privacy",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "dest": "/privacy.rsc",
      "headers": {
        "Content-Type": "text/x-component; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/t-claps",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "dest": "/t-claps.rsc",
      "headers": {
        "Content-Type": "text/x-component; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/what-is-f3",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "dest": "/what-is-f3.rsc",
      "headers": {
        "Content-Type": "text/x-component; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/workouts",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "dest": "/workouts.rsc",
      "headers": {
        "Content-Type": "text/x-component; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/connect\\.html",
      "status": 308,
      "headers": {
        "Location": "/connect"
      }
    },
    {
      "src": "/disclaimer\\.html",
      "status": 308,
      "headers": {
        "Location": "/disclaimer"
      }
    },
    {
      "src": "/photos\\.html",
      "status": 308,
      "headers": {
        "Location": "/photos"
      }
    },
    {
      "src": "/privacy\\.html",
      "status": 308,
      "headers": {
        "Location": "/privacy"
      }
    },
    {
      "src": "/t-claps\\.html",
      "status": 308,
      "headers": {
        "Location": "/t-claps"
      }
    },
    {
      "src": "/what-is-f3\\.html",
      "status": 308,
      "headers": {
        "Location": "/what-is-f3"
      }
    },
    {
      "src": "/workouts\\.html",
      "status": 308,
      "headers": {
        "Location": "/workouts"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/connect",
      "dest": "/connect.html"
    },
    {
      "src": "/disclaimer",
      "dest": "/disclaimer.html"
    },
    {
      "src": "/photos",
      "dest": "/photos.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/t-claps",
      "dest": "/t-claps.html"
    },
    {
      "src": "/what-is-f3",
      "dest": "/what-is-f3.html"
    },
    {
      "src": "/workouts",
      "dest": "/workouts.html"
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "/(.*)",
      "dest": "/404.html"
    }
  ]
}
